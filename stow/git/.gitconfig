[core]
	pager = delta
	# avoid problems when changing a case of a filename
	ignorecase = false
	excludesfile = /Users/peter/.config/git/ignore
	untrackedcache = true
	fsmonitor = true

[pager]
	diff = delta
	log = delta
	reflog = delta
	show = delta

[includeIf "gitdir:~/Work/"]
    path = ~/.gitconfig-gitlab

[includeIf "gitdir:~/Code/"]
    path = ~/.gitconfig-github

[includeIf "gitdir:~/.dotfiles/"]
    path = ~/.gitconfig-github

[includeIf "gitdir:~/Code/cursor/"]
    path = ~/.gitconfig-bitbucket

[interactive]
	diffFilter = delta --color-only

[delta]
	side-by-side = true
	navigate = true

	# File headers
	file-style = bold yellow
	file-decoration-style = yellow ul

	# Hunk headers
	hunk-header-style = bold blue
	hunk-header-decoration-style = blue box

	# Line numbers
	line-numbers = true
	line-numbers-left-format = {nm:>3}│
	line-numbers-right-format = {np:>3}│
	line-numbers-left-style = dim
	line-numbers-right-style = dim
	line-numbers-minus-style = red
	line-numbers-plus-style = green
	line-numbers-zero-style = dim

	# Removed lines
	minus-style = red dim
	minus-emph-style = red bold
	minus-empty-line-marker-style = omit

	# Added lines
	plus-style = green dim
	plus-emph-style = green bold
	plus-empty-line-marker-style = omit

	# Unchanged lines
	zero-style = dim

	# Color handling
	true-color = auto

[submodule]
	recurse = true
[pull]
	rebase = true
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
