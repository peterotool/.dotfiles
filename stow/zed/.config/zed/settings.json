{
    // Editor Appearance
    "edit_predictions": {
        "allow_data_collection": "yes"
    },
    "outline_panel": {
        "dock": "left"
    },
    "collaboration_panel": {
        "dock": "left"
    },
    "diff_view_style": "split",
    "git_panel": {
        "dock": "left"
    },
    "buffer_font_family": "MesloLGS Nerd Font Mono",
    "buffer_font_size": 15,
    "tab_size": 4,
    "preview_tabs": {
        "enabled": false
    },
    "project_panel": {
        "dock": "left"
    },
    "gutter": {
        "line_numbers": true
    },
    "minimap": {
        "show": "never"
    },
    // Theme
    "theme": {
        "mode": "dark",
        "light": "One Light",
        "dark": "Catppuccin Mocha"
    },
    "icon_theme": {
        "mode": "dark",
        "light": "Catppuccin Mocha",
        "dark": "Catppuccin Mocha"
    },
    // Markdown
    "markdown_preview": {
        "limit_content_width": false
    },
    // Tabs
    "tabs": { "file_icons": true },
    // Terminal
    "terminal": {
        "dock": "bottom",
        "font_family": "MesloLGS Nerd Font Mono",
        "font_size": 15,
        "cursor_shape": "bar"
    },
    // Editor Behavior
    "vim_mode": true,
    "which_key": {
        "enabled": true,
        "delay_ms": 300
    },
    "file_scan_exclusions": ["**/.DS_Store"],
    "autosave": {
        "after_delay": { "milliseconds": 500 }
    },
    "format_on_save": "on",
    "restore_on_startup": "last_session",
    "show_completions_on_input": true,
    "ui_font_size": 16,
    "relative_line_numbers": "enabled",
    "cursor_blink": false,
    "scrollbar": { "show": "never" },
    "buffer_line_height": { "custom": 1.5 },
    "agent_servers": {
        "claude-acp": {
            "type": "registry"
        }
    },
    "agent": {
        "play_sound_when_agent_done": "always",
        "default_profile": "ask",
        "dock": "right"
    },
    "cli_default_open_behavior": "existing_window",
    // Privacy & Telemetry
    "telemetry": {
        "diagnostics": false,
        "metrics": false
    },

    "file_types": {
        "Dockerfile": ["Docker*"]
    },
    // Language-Specific Settings
    "languages": {
        "Python": {
            "formatter": {
                "external": {
                    "command": "sh",
                    "arguments": [
                        "-c",
                        "ruff check --fix --stdin-filename {buffer_path} - | ruff format --stdin-filename {buffer_path} -"
                    ]
                }
            },
            "format_on_save": "on"
        },
        "Terraform": {
            // in Zed tflint is implemented as a LSP
            "language_servers": ["tflint", "terraform-ls"],
            "formatter": {
                "external": {
                    "command": "sh",
                    "arguments": ["-c", "terraform fmt - | cat -s"]
                }
            },
            "format_on_save": "on"
        },
        "Lua": {
            "formatter": {
                "external": {
                    "command": "stylua",
                    "arguments": ["-"]
                }
            },
            "format_on_save": "on"
        },
        "TOML": {
            "formatter": {
                "external": {
                    "command": "taplo",
                    "arguments": ["fmt", "-o", "indent_string=    ", "-"]
                }
            },
            "format_on_save": "on"
        },
        "YAML": {
            "formatter": {
                "external": {
                    "command": "prettier",
                    "arguments": [
                        "--tab-width",
                        "4",
                        "--stdin-filepath",
                        "{buffer_path}"
                    ]
                }
            },
            "format_on_save": "on"
        },
        "JSON": {
            "formatter": {
                "external": {
                    "command": "prettier",
                    "arguments": [
                        "--tab-width",
                        "4",
                        "--stdin-filepath",
                        "{buffer_path}"
                    ]
                }
            },
            "format_on_save": "on"
        },
        "Markdown": {
            "formatter": {
                "external": {
                    "command": "prettier",
                    "arguments": [
                        "--tab-width",
                        "4",
                        "--ignore-path",
                        "/dev/null",
                        "--stdin-filepath",
                        "{buffer_path}"
                    ]
                }
            },
            "format_on_save": "on"
        },
        "Shell Script": {
            "formatter": {
                "external": {
                    "command": "shfmt",
                    "arguments": [
                        "--filename",
                        "{buffer_path}",
                        "--indent",
                        "4"
                    ]
                }
            },
            "format_on_save": "on"
        }
    },
    "lsp": {
        "markdownlint": {
            "settings": {
                // First, set the default
                "default": true,
                // MD041: Ensure the first line of the file is a top-level heading
                "MD041": true,
                // MD046: Specify the style for code blocks (fenced or indented)
                "MD046": {
                    "style": "fenced"
                },
                // MD049: Ensure emphasis styles (e.g., bold, italic) are consistent
                "MD049": false,
                // MD003: Specify the style for headers (e.g., "atx" for #, "setext" for ===)
                "MD003": {
                    "style": "atx"
                },
                // MD035: Specify the style for horizontal rules (e.g., "---")
                "MD035": {
                    "style": "---"
                },
                // MD013: Configure line length rules for code blocks, tables, and headings
                "MD013": false,
                // MD024: Disallow duplicate headings within the same parent section
                "MD024": {
                    "siblings_only": true // Only check for duplicates among sibling headings
                },
                // MD036: Disallow emphasis (e.g., bold, italic) as a substitute for headings
                "MD036": false,
                // MD033: Disallow inline HTML in Markdown
                "MD033": false,
                // MD026: Disallow trailing punctuation in headings
                "MD026": {
                    "punctuation": ".,;:!。，；：！？" // List of punctuation characters to check
                },
                // MD009: Disallow trailing spaces at the end of lines
                "MD009": false,
                // MD052: Disallow reference-style links and images
                "MD052": false,
                // MD004: Specify the style for unordered lists (e.g., "dash" for "-", "asterisk" for "*")
                "MD004": {
                    "style": "dash"
                },
                // MD007: Set the indentation level for unordered lists
                "MD007": {
                    "indent": 4
                },
                // MD034: Disallow bare URLs (URLs must be wrapped in angle brackets or links)
                "MD034": false,
                // MD029: Disallow inconsistent ordered list prefixes (e.g., "1. 1. 1.")
                "MD029": false,
                // MD044: Ensure proper names are spelled correctly
                "MD044": false
            }
        }
    }
}
