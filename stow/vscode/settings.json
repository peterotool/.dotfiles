{
  "editor.accessibilitySupport": "off",
  "editor.minimap.enabled": false,
  "files.exclude": {
    "**/.git": false,
  },
  "terminal.integrated.shellIntegration.enabled": true,
  // "terminal.integrated.suggest.enabled": true,
  "terminal.integrated.fontFamily": "MesloLGS Nerd Font Mono",
  // Format on save (global or per-language)
  "editor.formatOnSave": true,
  // Python
  "[python]": {
    "editor.codeActionsOnSave": {
      "source.fixAll": "explicit",
      "source.organizeImports": "explicit",
    },
    "editor.defaultFormatter": "charliermarsh.ruff",
  },
  // Terraform
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true,
  },
  // Json
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  // Markdown
  "[markdown]": {
    "editor.codeActionsOnSave": {
      "source.fixAll.markdownlint": "explicit",
    },
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint",
  },
  // Markdownlint
  // https://marketplace.visualstudio.com/items?itemName=DavidAnson.vscode-markdownlint
  "markdownlint.config": {
    // First, set the default
    "default": true,

    // Per-rule settings in alphabetical order

    // MD041: Ensure the first line of the file is a top-level heading
    "MD041": true,

    // MD046: Specify the style for code blocks (fenced or indented)
    "MD046": {
      "style": "fenced",
    },

    // MD049: Ensure emphasis styles (e.g., bold, italic) are consistent
    "MD049": false,

    // MD003: Specify the style for headers (e.g., "atx" for #, "setext" for ===)
    "MD003": {
      "style": "atx",
    },

    // MD035: Specify the style for horizontal rules (e.g., "---")
    "MD035": {
      "style": "---",
    },

    // MD013: Configure line length rules for code blocks, tables, and headings
    "MD013": false,

    // MD024: Disallow duplicate headings within the same parent section
    "MD024": {
      "siblings_only": true, // Only check for duplicates among sibling headings
    },

    // MD036: Disallow emphasis (e.g., bold, italic) as a substitute for headings
    "MD036": false,

    // MD033: Disallow inline HTML in Markdown
    "MD033": false,

    // MD026: Disallow trailing punctuation in headings
    "MD026": {
      "punctuation": ".,;:!。，；：！？", // List of punctuation characters to check
    },

    // MD009: Disallow trailing spaces at the end of lines
    "MD009": false,

    // MD052: Disallow reference-style links and images
    "MD052": false,

    // MD004: Specify the style for unordered lists (e.g., "dash" for "-", "asterisk" for "*")
    "MD004": {
      "style": "dash",
    },

    // MD034: Disallow bare URLs (URLs must be wrapped in angle brackets or links)
    "MD034": false,

    // MD029: Disallow inconsistent ordered list prefixes (e.g., "1. 1. 1.")
    "MD029": false,

    // MD044: Ensure proper names are spelled correctly
    "MD044": false,
  },
  "markdownlint.run": "onSave",
  "workbench.editor.enablePreview": false,
  // Vim
  // https://gist.github.com/RainbowDashy/c72e330aa66f2fd609b51c6bf9887780
  // https://dev.to/ansonh/10-vs-code-vim-tricks-to-boost-your-productivity-1b0n#9-highlight-yanked-text
  "editor.lineNumbers": "relative",
  // Cursor Surrounding Lines
  "editor.cursorSurroundingLines": 8,
  "terminal.integrated.allowedLinkSchemes": [
    "file",
    "http",
    "https",
    "mailto",
    "vscode",
    "vscode-insiders",
    "docker-desktop",
  ],
  "docker.extension.enableComposeLanguageServer": false,
  "terminal.integrated.initialHint": false,
  "azureTerraform.survey": {
    "surveyPromptDate": "2026-10-01T15:40:29.249Z",
    "surveyPromptIgnoredCount": 4
  },
  "claudeCode.preferredLocation": "panel",
  "claudeCode.disableLoginPrompt": true,
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
